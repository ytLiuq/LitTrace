{
  "$defs": {
    "APIConfig": {
      "properties": {
        "user_agent": {
          "default": "LitTrace/0.1",
          "title": "User Agent",
          "type": "string"
        },
        "openalex_api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openalex Api Key"
        },
        "unpaywall_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unpaywall Email"
        },
        "crossref_mailto": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crossref Mailto"
        },
        "core_api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Core Api Key"
        },
        "enable_europe_pmc": {
          "default": true,
          "title": "Enable Europe Pmc",
          "type": "boolean"
        },
        "enable_arxiv": {
          "default": true,
          "title": "Enable Arxiv",
          "type": "boolean"
        },
        "semantic_scholar_api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Scholar Api Key"
        },
        "enable_semantic_scholar": {
          "default": false,
          "title": "Enable Semantic Scholar",
          "type": "boolean"
        },
        "enable_chemrxiv": {
          "default": true,
          "title": "Enable Chemrxiv",
          "type": "boolean"
        },
        "enable_semantic_query_planner": {
          "default": true,
          "title": "Enable Semantic Query Planner",
          "type": "boolean"
        },
        "request_timeout_seconds": {
          "default": 20.0,
          "title": "Request Timeout Seconds",
          "type": "number"
        },
        "enable_live_search": {
          "default": false,
          "title": "Enable Live Search",
          "type": "boolean"
        }
      },
      "title": "APIConfig",
      "type": "object"
    },
    "AgentRuntimeConfig": {
      "description": "Execution runtime selected for interactive chat turns.\n\n``legacy`` keeps the existing in-process coordinator.  The App Server\nruntime is deliberately opt-in while domain mutations move behind\ncontrolled, idempotent MCP commands.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/AgentRuntimeMode",
          "default": "legacy"
        },
        "codex_command": {
          "items": {
            "type": "string"
          },
          "title": "Codex Command",
          "type": "array"
        },
        "codex_config_overrides": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Codex Config Overrides",
          "type": "object"
        },
        "codex_home_mode": {
          "$ref": "#/$defs/CodexHomeMode",
          "default": "isolated"
        },
        "codex_home": {
          "default": "data/codex-home",
          "format": "path",
          "title": "Codex Home",
          "type": "string"
        },
        "scratch_root": {
          "default": "data/codex-runtime",
          "format": "path",
          "title": "Scratch Root",
          "type": "string"
        },
        "startup_timeout_seconds": {
          "default": 20.0,
          "title": "Startup Timeout Seconds",
          "type": "number"
        },
        "request_timeout_seconds": {
          "default": 60.0,
          "title": "Request Timeout Seconds",
          "type": "number"
        },
        "turn_timeout_seconds": {
          "default": 300.0,
          "title": "Turn Timeout Seconds",
          "type": "number"
        },
        "fallback_to_legacy": {
          "default": true,
          "title": "Fallback To Legacy",
          "type": "boolean"
        },
        "mcp_server_name": {
          "default": "littrace",
          "title": "Mcp Server Name",
          "type": "string"
        },
        "sandbox_policy": {
          "$ref": "#/$defs/SandboxPolicy",
          "default": "read-only"
        },
        "writable_roots": {
          "items": {
            "format": "path",
            "type": "string"
          },
          "title": "Writable Roots",
          "type": "array"
        },
        "interrupt_grace_seconds": {
          "default": 10.0,
          "title": "Interrupt Grace Seconds",
          "type": "number"
        },
        "rollout_enabled": {
          "default": false,
          "title": "Rollout Enabled",
          "type": "boolean"
        },
        "rollout_dir": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rollout Dir"
        }
      },
      "title": "AgentRuntimeConfig",
      "type": "object"
    },
    "AgentRuntimeMode": {
      "enum": [
        "legacy",
        "codex_app_server"
      ],
      "title": "AgentRuntimeMode",
      "type": "string"
    },
    "ArtifactStorageConfig": {
      "properties": {
        "backend": {
          "default": "local",
          "title": "Backend",
          "type": "string"
        },
        "local_root": {
          "default": "data/artifacts",
          "format": "path",
          "title": "Local Root",
          "type": "string"
        },
        "bucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bucket"
        },
        "endpoint_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Url"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "path_prefix": {
          "default": "",
          "title": "Path Prefix",
          "type": "string"
        }
      },
      "title": "ArtifactStorageConfig",
      "type": "object"
    },
    "BrowserAutomationConfig": {
      "properties": {
        "browser_act_path": {
          "default": "browser-act",
          "title": "Browser Act Path",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "default_browser_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Browser Id"
        },
        "default_browser_name": {
          "default": "littrace-publisher-auth",
          "title": "Default Browser Name",
          "type": "string"
        },
        "default_browser_type": {
          "default": "chrome",
          "title": "Default Browser Type",
          "type": "string"
        },
        "confirm_before_use": {
          "default": true,
          "title": "Confirm Before Use",
          "type": "boolean"
        },
        "allow_confirm_browser_fallback": {
          "default": true,
          "title": "Allow Confirm Browser Fallback",
          "type": "boolean"
        },
        "chrome_direct_open_retries": {
          "default": 3,
          "title": "Chrome Direct Open Retries",
          "type": "integer"
        },
        "chrome_direct_retry_delay_seconds": {
          "default": 2.0,
          "title": "Chrome Direct Retry Delay Seconds",
          "type": "number"
        }
      },
      "title": "BrowserAutomationConfig",
      "type": "object"
    },
    "CDPDownloaderConfig": {
      "properties": {
        "cdp_url": {
          "default": "http://127.0.0.1:19222",
          "title": "Cdp Url",
          "type": "string"
        },
        "default_output_dir": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Output Dir"
        },
        "chrome_executable": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chrome Executable"
        },
        "chrome_user_data_dir": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "data/chrome-cdp",
          "title": "Chrome User Data Dir"
        },
        "chrome_profile_name": {
          "default": "Default",
          "title": "Chrome Profile Name",
          "type": "string"
        },
        "remote_debugging_port": {
          "default": 19222,
          "title": "Remote Debugging Port",
          "type": "integer"
        },
        "auto_launch_chrome": {
          "default": true,
          "title": "Auto Launch Chrome",
          "type": "boolean"
        },
        "headless": {
          "default": true,
          "title": "Headless",
          "type": "boolean"
        },
        "cloudflare_wait_seconds": {
          "default": 60.0,
          "title": "Cloudflare Wait Seconds",
          "type": "number"
        },
        "user_action_wait_seconds": {
          "default": 300.0,
          "title": "User Action Wait Seconds",
          "type": "number"
        },
        "command_timeout_seconds": {
          "default": 60.0,
          "title": "Command Timeout Seconds",
          "type": "number"
        },
        "repository_download_timeout_seconds": {
          "default": 120.0,
          "title": "Repository Download Timeout Seconds",
          "type": "number"
        },
        "websocket_reconnect_attempts": {
          "default": 3,
          "title": "Websocket Reconnect Attempts",
          "type": "integer"
        }
      },
      "title": "CDPDownloaderConfig",
      "type": "object"
    },
    "CitationGuardConfig": {
      "description": "Configuration for the citation guard's claim-hint word list.\n\n``claim_hints`` is a list of keywords that trigger citation checking.\nSentences containing any of these words are considered \"claim-bearing\"\nand must have citation anchors. Extend this list for domain-specific\nvocabulary (e.g. add \"gauge factor\", \"TFT\", \"bandgap\" for sensor research).",
      "properties": {
        "claim_hints": {
          "items": {
            "type": "string"
          },
          "title": "Claim Hints",
          "type": "array"
        }
      },
      "title": "CitationGuardConfig",
      "type": "object"
    },
    "CodexHomeMode": {
      "description": "How the App Server process resolves its Codex state directory.",
      "enum": [
        "isolated",
        "shared"
      ],
      "title": "CodexHomeMode",
      "type": "string"
    },
    "CompactionConfig": {
      "description": "Round 5 settings for the Codex thread-compaction worker.\n\n``threshold_turns`` and ``threshold_tokens`` are OR-ed when\ndeciding whether a session is due for compaction. Once a\nsuccessful ``thread/compact`` RPC runs, ``last_compacted_at``\nis stamped and the session is ignored for one hour\nregardless of how fast more turns pile up.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "background_worker_enabled": {
          "default": false,
          "title": "Background Worker Enabled",
          "type": "boolean"
        },
        "interval_seconds": {
          "default": 60.0,
          "title": "Interval Seconds",
          "type": "number"
        },
        "batch_size": {
          "default": 5,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_attempts": {
          "default": 3,
          "title": "Max Attempts",
          "type": "integer"
        },
        "base_delay_seconds": {
          "default": 30.0,
          "title": "Base Delay Seconds",
          "type": "number"
        },
        "threshold_turns": {
          "default": 30,
          "title": "Threshold Turns",
          "type": "integer"
        },
        "threshold_tokens": {
          "default": 50000,
          "title": "Threshold Tokens",
          "type": "integer"
        },
        "request_timeout_seconds": {
          "default": 120.0,
          "title": "Request Timeout Seconds",
          "type": "number"
        }
      },
      "title": "CompactionConfig",
      "type": "object"
    },
    "CostBudgetConfig": {
      "description": "Token cost budget and tracking configuration.\n\nSet ``max_total_tokens`` to 0 to disable budget enforcement.",
      "properties": {
        "max_total_tokens": {
          "default": 0,
          "title": "Max Total Tokens",
          "type": "integer"
        },
        "max_tokens_per_call": {
          "default": 0,
          "title": "Max Tokens Per Call",
          "type": "integer"
        },
        "price_per_1k_input": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Price Per 1K Input",
          "type": "object"
        },
        "price_per_1k_output": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Price Per 1K Output",
          "type": "object"
        },
        "budget_warning_threshold": {
          "default": 0.8,
          "title": "Budget Warning Threshold",
          "type": "number"
        },
        "persist_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persist Path"
        },
        "max_persist_entries": {
          "default": 5000,
          "title": "Max Persist Entries",
          "type": "integer"
        }
      },
      "title": "CostBudgetConfig",
      "type": "object"
    },
    "DoclingParserConfig": {
      "properties": {
        "export_markdown": {
          "default": true,
          "title": "Export Markdown",
          "type": "boolean"
        },
        "extract_tables": {
          "default": true,
          "title": "Extract Tables",
          "type": "boolean"
        },
        "extract_figures": {
          "default": true,
          "title": "Extract Figures",
          "type": "boolean"
        },
        "describe_figures": {
          "default": false,
          "title": "Describe Figures",
          "type": "boolean"
        }
      },
      "title": "DoclingParserConfig",
      "type": "object"
    },
    "DownloadMode": {
      "enum": [
        "ask_each_time",
        "download_open_access",
        "download_selected",
        "download_all_allowed"
      ],
      "title": "DownloadMode",
      "type": "string"
    },
    "DownloadRetryConfig": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "background_worker_enabled": {
          "default": false,
          "title": "Background Worker Enabled",
          "type": "boolean"
        },
        "interval_seconds": {
          "default": 30.0,
          "title": "Interval Seconds",
          "type": "number"
        },
        "batch_size": {
          "default": 10,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_attempts": {
          "default": 3,
          "title": "Max Attempts",
          "type": "integer"
        },
        "base_delay_seconds": {
          "default": 60.0,
          "title": "Base Delay Seconds",
          "type": "number"
        }
      },
      "title": "DownloadRetryConfig",
      "type": "object"
    },
    "EvalConfig": {
      "properties": {
        "golden_set_dir": {
          "default": "eval/golden",
          "format": "path",
          "title": "Golden Set Dir",
          "type": "string"
        },
        "rag_golden_set_dir": {
          "default": "eval/rag_golden",
          "format": "path",
          "title": "Rag Golden Set Dir",
          "type": "string"
        },
        "traces_dir": {
          "default": "eval/traces",
          "format": "path",
          "title": "Traces Dir",
          "type": "string"
        }
      },
      "title": "EvalConfig",
      "type": "object"
    },
    "FigureEnrichmentConfig": {
      "description": "Optional asynchronous multimodal enrichment for extracted figures.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt": {
          "default": "Analyze this scientific figure conservatively. Return JSON only with exactly these fields: figure_type (string), visual_summary (string), observations (array of strings), ocr_text (array of strings), confidence (number from 0 to 1). Only report details visible in the image or stated in the caption. Do not infer unshown experimental results.",
          "title": "Prompt",
          "type": "string"
        },
        "max_figures_per_job": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Figures Per Job",
          "type": "integer"
        },
        "min_confidence": {
          "default": 0.65,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Confidence",
          "type": "number"
        }
      },
      "title": "FigureEnrichmentConfig",
      "type": "object"
    },
    "HarnessThresholdConfig": {
      "description": "Thresholds for harness quality checks — configurable via config.yaml.",
      "properties": {
        "performance_confidence": {
          "default": 0.65,
          "title": "Performance Confidence",
          "type": "number"
        },
        "artifact_confidence": {
          "default": 0.6,
          "title": "Artifact Confidence",
          "type": "number"
        },
        "storyline_confidence": {
          "default": 0.7,
          "title": "Storyline Confidence",
          "type": "number"
        },
        "storyline_chain_min_evidence": {
          "default": 3,
          "title": "Storyline Chain Min Evidence",
          "type": "integer"
        }
      },
      "title": "HarnessThresholdConfig",
      "type": "object"
    },
    "LLMConfig": {
      "properties": {
        "provider": {
          "default": "deepseek",
          "title": "Provider",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "base_url": {
          "default": "https://api.deepseek.com",
          "title": "Base Url",
          "type": "string"
        },
        "model": {
          "default": "deepseek-chat",
          "title": "Model",
          "type": "string"
        },
        "fallback_models": {
          "items": {
            "type": "string"
          },
          "title": "Fallback Models",
          "type": "array"
        },
        "fallback_api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Api Key"
        },
        "fallback_base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Base Url"
        },
        "fallback_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Model"
        },
        "request_timeout_seconds": {
          "default": 60.0,
          "title": "Request Timeout Seconds",
          "type": "number"
        },
        "metric_extraction_timeout_seconds": {
          "default": 150.0,
          "title": "Metric Extraction Timeout Seconds",
          "type": "number"
        },
        "temperature": {
          "default": 0.2,
          "title": "Temperature",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "intent_parser_enabled": {
          "default": true,
          "title": "Intent Parser Enabled",
          "type": "boolean"
        }
      },
      "title": "LLMConfig",
      "type": "object"
    },
    "LiteratureContextDefaults": {
      "properties": {
        "visible_to_user": {
          "default": true,
          "title": "Visible To User",
          "type": "boolean"
        },
        "default_year_min": {
          "default": 2023,
          "title": "Default Year Min",
          "type": "integer"
        },
        "default_recent_year_min": {
          "default": 2023,
          "title": "Default Recent Year Min",
          "type": "integer"
        },
        "active_context_limit": {
          "default": 15,
          "title": "Active Context Limit",
          "type": "integer"
        },
        "preferred_disciplines": {
          "items": {
            "type": "string"
          },
          "title": "Preferred Disciplines",
          "type": "array"
        },
        "preferred_publishers": {
          "items": {
            "type": "string"
          },
          "title": "Preferred Publishers",
          "type": "array"
        },
        "preferred_journals": {
          "items": {
            "type": "string"
          },
          "title": "Preferred Journals",
          "type": "array"
        }
      },
      "title": "LiteratureContextDefaults",
      "type": "object"
    },
    "MetadataStoreConfig": {
      "properties": {
        "backend": {
          "default": "postgres",
          "title": "Backend",
          "type": "string"
        },
        "postgres_dsn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "postgresql://littrace:littrace@localhost:5433/littrace",
          "title": "Postgres Dsn"
        },
        "schema_name": {
          "default": "littrace",
          "title": "Schema Name",
          "type": "string"
        },
        "connect_timeout_seconds": {
          "default": 5,
          "title": "Connect Timeout Seconds",
          "type": "integer"
        },
        "allow_schema_reset": {
          "default": false,
          "title": "Allow Schema Reset",
          "type": "boolean"
        }
      },
      "title": "MetadataStoreConfig",
      "type": "object"
    },
    "PaddleOCRParserConfig": {
      "properties": {
        "lang": {
          "default": "en",
          "title": "Lang",
          "type": "string"
        },
        "use_angle_cls": {
          "default": true,
          "title": "Use Angle Cls",
          "type": "boolean"
        },
        "pdf_render_scale": {
          "default": 2.0,
          "title": "Pdf Render Scale",
          "type": "number"
        },
        "max_pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pages"
        },
        "ocr_batch_size": {
          "default": 4,
          "title": "Ocr Batch Size",
          "type": "integer"
        },
        "ocr_page_workers": {
          "default": 1,
